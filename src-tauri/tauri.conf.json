{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XPicker",
  "version": "../package.json",
  "identifier": "com.quintixlabs.xpicker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "publisher": "Quintix Labs",
    "copyright": "Copyright © Quintix Labs",
    "shortDescription": "Lightweight, simple, and easy-to-use screen color picker",
    "icon": [
      "icons/app/32x32.png",
      "icons/app/128x128.png",
      "icons/app/128x128@2x.png",
      "icons/app/icon.icns",
      "icons/app/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/app/icon.ico",
        "uninstallerIcon": "icons/app/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": { "English": "installer/English.nsh" }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOEEzMzBGMDIxRUNEQ0IKUldUTHpSNENEek9LWUVYYnI5eDJGeVROZUViRFRzSkhpd0h6Qk5Tcnh4N1hhc2l0R1pYZGNoZ24K",
      "endpoints": [
        "https://github.com/QuintixLabs/XPicker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
